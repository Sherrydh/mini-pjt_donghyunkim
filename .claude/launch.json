{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "piano-agent",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "src.api:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "piano-streamlit",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "streamlit_app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
